{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1    =/\\                 /\\=\n$1    / \\'._   ($2\\_/$1)   _.'/ \\\n$1   / .''._'--($2o.o$1)--'_.''. \\\n$1  /.' _/ |`'=/ \" \\='`| \\_ `.\\\n$1 /` .' `\\;-,'\\___/',-;/` '. '\\\n$1/.-'       `\\($2-V-$1)/`       `-.\\\n$1`            \"   \"            `",
    "color": {
      "1": "#BD93F9",
      "2": "#FF79C6"
    },
    "padding": {
      "top": 0,
      "right": 2
    }
  },
  "display": {
    "separator": " \u203a ",
    "brightColor": true,
    "key": {
      "width": 7
    },
    "color": {
      "keys": "#BD93F9",
      "title": "#FF79C6",
      "separator": "#6272A4"
    },
    "size": {
      "ndigits": 0
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#FF79C6",
        "at": "#6272A4",
        "host": "#BD93F9"
      }
    },
    {
      "type": "separator",
      "string": "\u2500"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Pkgs",
      "format": "{all}"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "Term"
    },
    {
      "type": "shell",
      "key": "Shell",
      "format": "{pretty-name}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Mem",
      "format": "{used}/{total} ({percentage})"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 0
    }
  ]
}
